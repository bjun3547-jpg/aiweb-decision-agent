{
  "_meta": {
    "name": "运筹决策 Agent 评测集",
    "version": "1.0",
    "created": "2026-10-24",
    "owner": "冯璐",
    "doc": "第 7 章 §7.1 表 8 的 30 题。每题 = 一段自然语言 + 一份可离线自证的标准答案。",
    "why_relative_dates": "题面里的日期全部相对「下周一」。绝对日期每天都会变，写死会让评测集隔天失效。日期锚点由 agent._date_anchors() 统一给出，与 Prompt 同一口径。",
    "how_truth_is_verified": "标准答案不是手写猜的：run_cases.py --validate 会把 expect 展开成 SchedulingProblem 直接喂给求解器，常规/边界题必须 OPTIMAL、冲突题必须报出期望的根因规则。标准答案本身先跑通，才允许调模型去对答案。",
    "scoring_fields": [
      "employee_count  员工人数",
      "employee_names  员工姓名集合",
      "skills          逐人技能集合",
      "shift_count     班次类型数",
      "shift_hours     每班起止小时",
      "shift_skill     每班技能要求",
      "dates           计划期日期列表（逐日比对）",
      "demand          每（日期×班次）的需求人数",
      "rules           四项全局规则",
      "unavailable     逐人不可用日期"
    ],
    "scoring_rule": "参数抽取准确率 = 通过的字段数 / 10（每题字段数相同，分母统一）。",
    "conflict_hit_rule": "冲突诊断命中 = 期望的根因规则出现在 result.conflicts[].rule 中（允许多报，不允许漏报根因）。"
  },

